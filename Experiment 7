#include <iostream>

using namespace std;

class Demo 
{
private:
    static int counter;

public:
    Demo() 
    {
        counter++;
    }

    static int getCounter() 
    {
        return counter;
    }
};

int Demo::counter = 0;

int main() 
{
    cout << "Initial count: " << Demo::getCounter() << endl;

    Demo obj1;
    Demo obj2;
    Demo obj3;

    cout << "Count after creating 3 objects: " << Demo::getCounter() << endl;

    return 0;
}
