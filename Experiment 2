#include <iostream>
#include <iomanip>

using namespace std;

int num = 100;

int main() 
{
    int num = 20;

    cout << "Local variable: " << num << endl;
    cout << "Global variable using scope resolution: " << ::num << endl;

    int* ptr = new int;
    *ptr = 50;

    cout << "Value in dynamically allocated memory: " << *ptr << endl;

    delete ptr;

    cout << "\nTesting manipulators:" << endl;
    cout << "Using setw and setfill:" << endl;
    cout << setfill('*') << setw(10) << 5 << endl;

    return 0;
}
