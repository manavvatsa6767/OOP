#include <iostream>

using namespace std;

class Student 
{
private:
    int rollNumber;

public:
    void setData(int r) 
    {
        rollNumber = r;
    }

    void displayData() 
    {
        cout << "Roll Number: " << rollNumber << endl;
    }
};

int main() 
{
    Student arr[3];

    arr[0].setData(101);
    arr[1].setData(102);
    arr[2].setData(103);

    for (int i = 0; i < 3; i++) 
    {
        arr[i].displayData();
    }

    return 0;
}
